# PVG AI — Environment Example
# Copy to .env for local development. NEVER put real production secrets here.

APP_ENV=development
APP_NAME=PVG AI
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:1420,http://localhost:5173,https://tauri.localhost,http://tauri.localhost,https://asset.localhost,http://asset.localhost,tauri://localhost

# PostgreSQL (development defaults — change for staging/production)
DATABASE_URL=postgresql+asyncpg://pvg_app:pvg_dev_change_me@localhost:5444/pvg
DATABASE_ADMIN_URL=postgresql+asyncpg://pvg_migrator:pvg_migrator_dev_change_me@localhost:5444/pvg

# Redis (host port 6480 maps to container 6379)
REDIS_URL=redis://localhost:6480/0

# Security — REQUIRED in production (leave empty in example)
# JWT_SECRET must be a long random string in staging/production
JWT_SECRET=
JWT_ISSUER=pvg-ai
JWT_AUDIENCE=pvg-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
CSRF_SECRET=
MFA_ENCRYPTION_KEY=
CREDENTIAL_VAULT_MASTER_KEY=

# Email (console for development/test; smtp required in staging/production when EMAIL_TRANSPORT=smtp)
EMAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
SMTP_TLS=true

# Google OAuth (optional in development)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Web / desktop auth
WEB_ORIGIN=http://localhost:5173
DESKTOP_AUTH_REDIRECT=http://localhost:5173/auth/desktop/callback

# Payments — sandbox only unless a live provider is explicitly configured
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=

# Rate limiting
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=20

# Feature flags (JSON object string)
FEATURE_FLAGS={"security_lab":false,"cloud_sync":false,"mfa_optional":true}

# Desktop local roots (optional overrides)
PVG_DATA_ROOT=
PVG_VAULT_BACKEND=

# --- Phase 2 Auth / Email / OAuth / Billing ---
JWT_ISSUER=pvg-ai
JWT_AUDIENCE=pvg-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
CSRF_SECRET=
MFA_ENCRYPTION_KEY=
WEB_ORIGIN=http://localhost:5173
DESKTOP_AUTH_REDIRECT=pvg://auth/callback

EMAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@pvg.ai
SMTP_USE_TLS=true

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=

RATE_LIMIT_AUTH_ACCOUNT_PER_MINUTE=10
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
