{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Phase 2 narrow capability set — opener for browser auth only; no shell, no unrestricted filesystem",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-set-title",
    "core:app:allow-version",
    "core:app:allow-name",
    "core:path:default",
    "opener:allow-open-url"
  ]
}
